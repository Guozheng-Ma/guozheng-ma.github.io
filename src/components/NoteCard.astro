---
import { type CollectionEntry } from 'astro:content';
import CoverArt from './CoverArt.astro';
interface Props { note: CollectionEntry<'notes'>; }
const { note } = Astro.props;
const topics: Record<string, string> = { purple: 'Sparsity & scaling', teal: 'Plasticity & adaptation', coral: 'Data & generalization' };
---
<a href={`/notes/${note.id}/`} class="note-card card-link" style={`--topic: var(--color-${note.data.cover.color}-800)`}>
  <CoverArt color={note.data.cover.color} />
  <div class="note-copy">
    <p class="topic-label"><span aria-hidden="true"></span>{topics[note.data.cover.color]}</p>
    <h3 class="font-serif-italic">{note.data.title}</h3>
    <p class="note-summary">{note.data.tldr}</p>
    <p class="note-meta">Research note · {note.data.readingTime} min read <span aria-hidden="true">↗</span></p>
  </div>
</a>
