---
import { getCollection } from 'astro:content';
import CoverArt from './CoverArt.astro';

const allNotes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
const preferredOrder = ['why-sparsify-rl-networks', 'plasticity-is-not-regularization', 'data-augmentation-in-visual-rl'];
const notes = [...allNotes].sort((a, b) => {
  const rank = (id: string) => preferredOrder.includes(id) ? preferredOrder.indexOf(id) : preferredOrder.length;
  return rank(a.id) - rank(b.id);
}).slice(0, 3);
const firstNote = notes[0];
---

{firstNote && <section class="home-section site-width notes-feature" aria-labelledby="notes-title" data-notes-feature>
  <div class="section-top">
    <h2 id="notes-title" class="section-heading">Notes</h2>
    <a href="/notes/" class="section-link">All notes <span aria-hidden="true">↗</span></a>
  </div>

  <div class="notes-static" data-notes-static>
    {notes.map((note, index) => <article>
      <a class="notes-static-entry" href={`/notes/${note.id}/`} aria-labelledby={`note-static-title-${index}`} data-note-static-link>
        <div class="notes-static-art" aria-hidden="true"><CoverArt color={note.data.cover.color} /></div>
        <div class="notes-static-copy">
          <h3 id={`note-static-title-${index}`}>{note.data.title}</h3>
          <p>{note.data.tldr}</p>
        </div>
      </a>
    </article>)}
  </div>

  <div class="notes-feature-view" data-notes-interactive hidden>
    <div class="notes-preview" id="notes-preview">
      {notes.map((note, index) => <div class:list={['notes-preview-layer', { 'is-selected': index === 0 }]} data-note-layer aria-hidden={index === 0 ? 'false' : 'true'}>
        <CoverArt color={note.data.cover.color} />
      </div>)}
    </div>
    <div class="notes-feature-copy">
      <div class="notes-choices" role="group" aria-label="Choose a note to preview">
        {notes.map((note, index) => <button
          type="button"
          class="notes-choice"
          aria-pressed={index === 0 ? 'true' : 'false'}
          aria-controls="notes-preview"
          aria-labelledby={`note-choice-title-${index}`}
          aria-describedby={`note-choice-summary-${index}`}
          data-note-choice
          data-note-title={note.data.title}
          data-note-href={`/notes/${note.id}/`}
        >
          <span class="notes-choice-title" id={`note-choice-title-${index}`}>{note.data.title}</span>
          <span class="notes-choice-summary" id={`note-choice-summary-${index}`}>{note.data.tldr}</span>
        </button>)}
      </div>
      <a class="notes-read-link" href={`/notes/${firstNote.id}/`} aria-label={`Read note: ${firstNote.data.title}`} data-note-read>
        Read note <span aria-hidden="true">↗</span>
      </a>
    </div>
  </div>
</section>}

<style>
  .notes-feature {
    --notes-panel: var(--color-bg-primary, #f1f0eb);
    --notes-hover: var(--color-bg-secondary, #e8e7e1);
    --notes-selected: var(--color-surface-active, var(--color-bg-tertiary, #fafaf8));
    --notes-art: var(--color-art-bg, var(--color-bg-tertiary, #f5f2ec));
    --notes-radius: var(--radius-xl, 24px);
    --notes-inner-radius: var(--radius-lg, 16px);
  }
  .notes-feature [hidden] { display: none !important; }
  .notes-static { display: grid; gap: 20px; }
  .notes-static-entry {
    display: grid;
    grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr);
    gap: 32px;
    align-items: center;
    padding: 24px;
    border-radius: var(--notes-radius);
    background: var(--notes-panel);
    color: var(--color-text-primary);
    text-decoration: none;
  }
  .notes-static-art { overflow: hidden; border-radius: var(--notes-inner-radius); }
  .notes-static-art :global(.cover-art) { background: var(--notes-art); }
  .notes-static-copy h3, .notes-choice-title {
    font: 400 24px / 1.25 var(--font-serif);
    letter-spacing: -.02em;
    text-wrap: pretty;
  }
  .notes-static-copy p, .notes-choice-summary {
    margin-top: 10px;
    font-size: 16.5px;
    line-height: 1.55;
    color: var(--color-text-secondary);
  }
  .notes-static-entry:hover h3 { text-decoration: underline; text-underline-offset: 4px; }
  .notes-feature-view {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: 28px;
    align-items: center;
    padding: 28px;
    border-radius: var(--notes-radius);
    background: var(--notes-panel);
  }
  .notes-preview {
    position: relative;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: var(--notes-inner-radius);
    background: var(--notes-art);
  }
  .notes-preview-layer { position: absolute; inset: 0; opacity: 0; pointer-events: none; transition: opacity 160ms ease; }
  .notes-preview-layer.is-selected { opacity: 1; }
  .notes-preview-layer :global(.cover-art) { width: 100%; height: 100%; background: var(--notes-art); }
  .notes-feature-copy { min-width: 0; }
  .notes-choices { display: grid; gap: 8px; }
  .notes-choice {
    display: block;
    width: 100%;
    padding: 18px 20px;
    border: 0;
    border-radius: var(--notes-inner-radius);
    background: transparent;
    color: var(--color-text-primary);
    text-align: left;
  }
  .notes-choice:hover { background: var(--notes-hover); }
  .notes-choice[aria-pressed="true"] { background: var(--notes-selected); }
  .notes-choice[aria-pressed="true"] .notes-choice-title { font-weight: 500; }
  .notes-choice-title, .notes-choice-summary { display: block; }
  .notes-choice:focus-visible { outline-offset: 3px; }
  .notes-read-link {
    display: inline-flex;
    gap: 10px;
    align-items: center;
    min-height: 44px;
    margin: 10px 20px 0;
    font-size: 16px;
    color: var(--color-text-primary);
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 5px;
  }
  @media (max-width: 600px) {
    .notes-static-entry { grid-template-columns: clamp(72px, 17vw, 88px) minmax(0, 1fr); gap: 14px 16px; padding: 18px; }
    .notes-static-art { grid-column: 1; grid-row: 1; }
    .notes-static-copy { display: contents; }
    .notes-static-copy h3 { grid-column: 2; grid-row: 1; font-size: 23px; }
    .notes-static-copy p { grid-column: 1 / -1; grid-row: 2; margin: 0; font-size: 16px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .notes-preview-layer { transition: none; }
  }
</style>

<script>
  document.querySelectorAll<HTMLElement>('[data-notes-feature]').forEach((feature) => {
    const staticView = feature.querySelector<HTMLElement>('[data-notes-static]');
    const interactiveView = feature.querySelector<HTMLElement>('[data-notes-interactive]');
    const choices = [...feature.querySelectorAll<HTMLButtonElement>('[data-note-choice]')];
    const layers = [...feature.querySelectorAll<HTMLElement>('[data-note-layer]')];
    const staticLinks = [...feature.querySelectorAll<HTMLAnchorElement>('[data-note-static-link]')];
    const readLink = feature.querySelector<HTMLAnchorElement>('[data-note-read]');
    if (!staticView || !interactiveView || !readLink || !choices.length || choices.length !== layers.length) return;

    const desktop = window.matchMedia('(min-width: 1100px) and (hover: hover) and (pointer: fine)');
    const hasTouchPointer = window.matchMedia('(any-pointer: coarse)');
    const touchDevice = navigator.maxTouchPoints > 0;
    let enabled = false;
    let selected = 0;
    let hoverTimer: ReturnType<typeof setTimeout> | undefined;
    let imagesPreloaded = false;

    const cancelHover = () => {
      if (hoverTimer !== undefined) window.clearTimeout(hoverTimer);
      hoverTimer = undefined;
    };
    const select = (index: number) => {
      cancelHover();
      if (!enabled || !choices[index]) return;
      selected = index;
      choices.forEach((choice, position) => choice.setAttribute('aria-pressed', String(position === index)));
      layers.forEach((layer, position) => {
        layer.classList.toggle('is-selected', position === index);
        layer.setAttribute('aria-hidden', String(position !== index));
      });
      readLink.href = choices[index].dataset.noteHref!;
      readLink.setAttribute('aria-label', `Read note: ${choices[index].dataset.noteTitle}`);
    };
    const updateMode = () => {
      cancelHover();
      const nextEnabled = desktop.matches && !hasTouchPointer.matches && !touchDevice;
      if (nextEnabled === enabled) return;

      const active = document.activeElement;
      const focusedChoice = choices.findIndex((choice) => choice === active);
      const focusedStatic = staticLinks.findIndex((link) => link === active);
      const focusedReadLink = active === readLink;
      enabled = nextEnabled;
      staticView.hidden = enabled;
      interactiveView.hidden = !enabled;

      if (enabled && !imagesPreloaded) {
        // Request all equal-size layers in both themes as soon as the desktop preview is enabled.
        interactiveView.querySelectorAll<HTMLImageElement>('img').forEach((image) => {
          image.loading = 'eager';
          image.fetchPriority = 'low';
          void image.decode().catch(() => {});
        });
        imagesPreloaded = true;
      }

      // Keep focus on the same note when a device or viewport change hides its current control.
      if (enabled && focusedStatic >= 0) choices[focusedStatic]?.focus({ preventScroll: true });
      if (!enabled && (focusedChoice >= 0 || focusedReadLink)) {
        staticLinks[focusedChoice >= 0 ? focusedChoice : selected]?.focus({ preventScroll: true });
      }
    };

    choices.forEach((choice, index) => {
      choice.addEventListener('click', () => select(index));
      choice.addEventListener('pointerenter', (event) => {
        cancelHover();
        if (enabled && event.pointerType !== 'touch') hoverTimer = window.setTimeout(() => select(index), 120);
      });
      choice.addEventListener('pointerleave', cancelHover);
      // Native buttons handle Enter/Space. Merely focusing a button never changes the selection.
      choice.addEventListener('keydown', cancelHover);
    });
    interactiveView.addEventListener('pointerleave', cancelHover);
    interactiveView.addEventListener('keydown', cancelHover);
    desktop.addEventListener('change', updateMode);
    hasTouchPointer.addEventListener('change', updateMode);
    updateMode();
  });
</script>
