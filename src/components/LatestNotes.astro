---
import { getCollection } from 'astro:content';
import CoverArt from './CoverArt.astro';
const allNotes = await getCollection('notes', ({ data }) => !data.draft);
const preferredOrder = ['agentic-policy', 'online-learning-from-experience', 'learning-dynamics-and-pathologies'];
const notes = preferredOrder.flatMap((id) => allNotes.filter((note) => note.id === id));
---
<section class="home-section site-width notes-feature" aria-labelledby="notes-title">
  <div class="section-top">
    <div>
      <h2 id="notes-title" class="section-heading">Blog</h2>
      <p class="section-description">Research directions and the questions behind my work.</p>
    </div>
    <a href="/notes/" class="section-link continuation-link">All Posts</a>
  </div>
  <div class="direction-grid">
    {notes.map((note) => <article class="direction-entry">
      <a class="direction-art" href={`/notes/${note.id}/`} tabindex="-1" aria-hidden="true"><CoverArt color={note.data.cover.color} art={note.data.cover.art} /></a>
      <h3><a href={`/notes/${note.id}/`}>{note.data.title}</a></h3>
      <p>{note.data.tldr}</p>
      <a class="continuation-link" href={`/notes/${note.id}/`} aria-label={`Read Post: ${note.data.title}`}>Read Post</a>
    </article>)}
  </div>
</section>
<style>
  .direction-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 32px; }
  .direction-entry { min-width: 0; display: flex; flex-direction: column; align-items: flex-start; }
  .direction-art { display: block; width: 100%; margin-bottom: 22px; }
  .direction-art :global(.cover-art) { aspect-ratio: 3 / 2; }
  .direction-entry h3 { font: 650 clamp(20px, 1.7vw, 23px)/1.3 var(--font-sans); letter-spacing: -.025em; }
  .direction-entry p { font: 400 18px/1.6 var(--font-serif); color: var(--color-text-secondary); margin-top: 12px; margin-bottom: 12px; }
  .direction-entry > .continuation-link { margin-top: auto; }
  @media (max-width: 800px) {
    .direction-grid { grid-template-columns: 1fr; gap: 0; }
    .direction-entry { display: grid; grid-template-columns: 210px minmax(0, 1fr); column-gap: 28px; padding-block: 26px; border-bottom: 1px solid var(--color-border-tertiary); }
    .direction-entry:first-child { padding-top: 0; }
    .direction-entry:last-child { border-bottom: 0; padding-bottom: 0; }
    .direction-art { grid-row: 1 / 4; margin: 0; align-self: center; }
    .direction-entry h3 { font-size: 22px; }
    .direction-entry > .continuation-link { justify-self: start; }
  }
  @media (max-width: 540px) {
    .direction-entry { grid-template-columns: 100px minmax(0, 1fr); column-gap: 18px; }
    .direction-art { grid-row: 1; align-self: start; }
    .direction-entry h3 { font-size: 21px; align-self: center; }
    .direction-entry p { grid-column: 1 / -1; font-size: 17px; margin-top: 14px; margin-bottom: 2px; }
    .direction-entry > .continuation-link { grid-column: 1 / -1; }
    .notes-feature .section-top { align-items: flex-start; }
  }
  @media print { .direction-grid { grid-template-columns: repeat(3,minmax(0,1fr)); } .direction-entry { break-inside: avoid; display: block; } }
</style>
