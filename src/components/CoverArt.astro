---
import ThemeImage from './ThemeImage.astro';
import { resolveNoteArt, type DirectionArtId } from '../lib/note-art';
interface Props { motif?: string; color?: string; art?: DirectionArtId; aspectRatio?: string; }
const { color = 'purple', art, aspectRatio = '3 / 2' } = Astro.props;
const selected = resolveNoteArt({ color, art });
---
<div class="cover-art" style={`aspect-ratio: ${aspectRatio}`}>
  <ThemeImage src={selected.src} alt={selected.alt} width="1200" height="800" />
</div>
