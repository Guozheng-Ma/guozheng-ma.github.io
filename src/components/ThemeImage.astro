---
interface Props {
  src: string;
  alt: string;
  width: number | string;
  height: number | string;
  loading?: 'eager' | 'lazy';
  fetchpriority?: 'high' | 'low' | 'auto';
  class?: string;
}
const { src, alt, width, height, loading = 'lazy', fetchpriority, class: className } = Astro.props;
const darkSources: Record<string, string> = {
  '/art/research-reap.webp': '/art/research-reap-dark.webp',
  '/art/portrait.webp': '/art/portrait-dark.webp',
  '/art/sparsity.webp': '/art/sparsity-dark.webp',
  '/art/plasticity.webp': '/art/plasticity-dark.webp',
  '/art/generalization.webp': '/art/generalization-dark.webp',
  '/art/agentic-policy.webp': '/art/agentic-policy-dark.webp',
  '/art/agentic-robot-learning-v4.webp': '/art/agentic-robot-learning-v4-dark.webp',
  '/art/agentic-robot-learning-v3.webp': '/art/agentic-robot-learning-v3-dark.webp',
  '/art/agentic-robot-learning.webp': '/art/agentic-robot-learning-dark.webp',
  '/art/online-experience.webp': '/art/online-experience-dark.webp',
  '/art/learning-dynamics.webp': '/art/learning-dynamics-dark.webp',
  '/art/online-experience-v2.webp': '/art/online-experience-v2-dark.webp',
  '/art/learning-dynamics-v2.webp': '/art/learning-dynamics-v2-dark.webp',
  '/art/learning-dynamics-v3.webp': '/art/learning-dynamics-v3-dark.webp',
  '/art/research-priors.webp': '/art/research-priors-dark.webp',
  '/art/research-priors-v2.webp': '/art/research-priors-v2-dark.webp',
  '/art/research-residual.webp': '/art/research-residual-dark.webp',
  '/art/research-sparsity.webp': '/art/research-sparsity-dark.webp',
  '/art/research-sparsity-v2.webp': '/art/research-sparsity-v2-dark.webp',
};
const darkSrc = darkSources[src];
---
<img src={src} {alt} {width} {height} {loading} {fetchpriority} class={className} decoding="async" data-theme-image={darkSrc ? 'light' : undefined} style={darkSrc ? 'display: var(--theme-image-light)' : undefined} />
{darkSrc && <img src={darkSrc} {alt} {width} {height} {loading} {fetchpriority} class={className} decoding="async" data-theme-image="dark" style="display: var(--theme-image-dark)" />}
