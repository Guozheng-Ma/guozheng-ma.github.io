---
import type { Update } from '../lib/cv';

interface Props { update: Update; }
const { update } = Astro.props;
const dateLabel = update.date.toLocaleDateString('en-US', {
  timeZone: 'UTC',
  month: 'short',
  year: 'numeric',
});

type Part = { type: 'text'; value: string } | { type: 'link'; value: string };
const parts: Part[] = [];
const brackets = /\[([^\]]+)\]/g;
let lastIndex = 0;
let match: RegExpExecArray | null;
while ((match = brackets.exec(update.text)) !== null) {
  if (match.index > lastIndex) parts.push({ type: 'text', value: update.text.slice(lastIndex, match.index) });
  parts.push({ type: 'link', value: match[1] });
  lastIndex = match.index + match[0].length;
}
if (lastIndex < update.text.length) parts.push({ type: 'text', value: update.text.slice(lastIndex) });

const href = update.relatedPub ? `/publications/${update.relatedPub}/` : null;
---
<li class="cv-entry">
  <time class="cv-date" datetime={update.date.toISOString().slice(0, 7)}>{dateLabel}</time>
  <p class="cv-text">
    {parts.map((part) => part.type === 'link' && href
      ? <a href={href}>{part.value}</a>
      : <Fragment>{part.value}</Fragment>
    )}
  </p>
</li>
