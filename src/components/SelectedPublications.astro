---
import { getCollection } from 'astro:content';
import PublicationCard from './PublicationCard.astro';
const allPubs = await getCollection('publications');
const featured = allPubs.filter((p) => p.data.featured).sort((a, b) => (a.data.featuredOrder ?? 0) - (b.data.featuredOrder ?? 0));
---
<section id="publications" class="home-section publications-section site-width" aria-labelledby="publications-title">
  <div class="section-top"><div><p class="eyebrow">From questions to experiments</p><h2 id="publications-title" class="section-heading">Selected publications</h2></div><a href="/publications/" class="section-link">All {allPubs.length} publications <span aria-hidden="true">↗</span></a></div>
  <div class="publications-list">{featured.map((pub) => <PublicationCard pub={pub} />)}</div>
</section>
