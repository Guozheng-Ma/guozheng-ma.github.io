---
import ThemeImage from './ThemeImage.astro';

interface Props { id: string; }
const { id } = Astro.props;
const illustrations: Record<string, { src: string; alt: string }> = {
  'neurips-2026-offline-priors': {
    src: '/art/research-priors.webp',
    alt: 'A wheeled robot encounters an obstruction, retaining useful prior guidance while adjusting its route using new evidence',
  },
  'icml-2026-residual': {
    src: '/art/research-residual.webp',
    alt: 'A robot gripper makes a small alignment correction for horizontal peg insertion, with nearby actions producing different contact outcomes',
  },
  'icml-2025-sparsity': {
    src: '/art/research-sparsity-v2.webp',
    alt: 'Technical paper cards compare a small dense weight matrix with a larger matrix containing a sparse, fixed set of nonzero weights',
  },
};
const illustration = illustrations[id];
---

{illustration && (
  <div class="research-thumbnail" data-research-illustration={id} aria-hidden="true">
    <ThemeImage src={illustration.src} alt={illustration.alt} width={1200} height={800} />
  </div>
)}

<style>
  .research-thumbnail {
    display: block;
    width: 100%;
    aspect-ratio: 3 / 2;
    overflow: hidden;
    border-radius: 12px;
  }

  .research-thumbnail :global(img) {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 3 / 2;
    object-fit: contain;
  }
</style>
