---
interface Props { name: 'paper' | 'code' | 'bibtex' | 'project' | 'video'; }
const { name } = Astro.props;
---
<svg class="publication-resource-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {name === 'paper' && <><path d="M14 3H6a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V9Z" /><path d="M14 3v6h6M8 13h8M8 17h5" /></>}
  {name === 'code' && <><path d="m7 7-5 5 5 5m10-10 5 5-5 5M14 4l-4 16" /></>}
  {name === 'bibtex' && <><path d="M10 6H4v7h6V6Zm10 0h-6v7h6V6ZM10 13c0 3-2 5-5 5m15-5c0 3-2 5-5 5" /></>}
  {name === 'project' && <><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 9h18M7 6.5h.01M10 6.5h.01" /></>}
  {name === 'video' && <><rect x="3" y="4" width="18" height="16" rx="2" /><path d="m10 8 6 4-6 4Z" /></>}
</svg>
