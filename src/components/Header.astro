---
import ThemeToggle from './ThemeToggle.astro';
interface Props { currentPath: string; }
const { currentPath } = Astro.props;
const navItems = [{ href: '/notes/', label: 'Notes' }, { href: '/publications/', label: 'Publications' }, { href: '/about/', label: 'About' }];
const isActive = (href: string) => currentPath.replace(/\/$/, '') === href.replace(/\/$/, '') || currentPath.startsWith(href);
---
<header id="site-header">
  <div class="header-row site-width">
    <a href="/" class="wordmark" aria-label="Guozheng Ma — home">Guozheng Ma<span class="wordmark-dot" aria-hidden="true">.</span></a>
    <div class="header-actions">
    <nav aria-label="Primary">
      {navItems.map((item) => <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>{item.label}</a>)}
    </nav>
    <ThemeToggle />
    </div>
  </div>
</header>
