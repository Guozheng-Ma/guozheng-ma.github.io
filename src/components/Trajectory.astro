---
import { loadCV } from '../lib/cv';

const { trajectory } = loadCV();
---
<ul class="cv-list">
  {trajectory.map((entry) => {
    const hasDate = /\d{4}/.test(entry.years);
    return (
      <li class:list={['cv-entry', { 'cv-entry-undated': !hasDate }]}>
        {hasDate && <p class="cv-date">{entry.years}</p>}
        <div class="cv-text">
          <p>{entry.place}</p>
          <p class="cv-role">{entry.role}</p>
        </div>
      </li>
    );
  })}
</ul>
