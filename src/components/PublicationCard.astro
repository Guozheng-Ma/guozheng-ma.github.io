---
import { type CollectionEntry } from 'astro:content';
import ResearchThumbnail from './ResearchThumbnail.astro';
import PublicationMeta from './PublicationMeta.astro';
import PublicationResourceIcon from './PublicationResourceIcon.astro';
import PublicationFigure from './PublicationFigure.astro';
import { publicationAreaLabels, publicationThemeLabels } from '../data/publication-topics';
import { publicationAuthors } from '../lib/publication-presentation';
interface Props { pub: CollectionEntry<'publications'>; compact?: boolean; headingLevel?: 'h2' | 'h3'; }
const { pub, compact = false, headingLevel: Heading = 'h3' } = Astro.props;
const d = pub.data;
const authors = publicationAuthors(d);
const hasEqualContributors = authors.some((author) => author.equalContribution);
const displayTitle = compact ? d.title.replaceAll('Reinforcement Learning', 'RL') : d.title;
const hasThumbnail = compact && ['neurips-2026-offline-priors', 'icml-2026-residual', 'icml-2025-sparsity'].includes(pub.id);
---
<article
  class:list={['publication-card', { 'publication-compact': compact, 'publication-illustrated': hasThumbnail, 'publication-index-card': !compact, 'publication-without-figure': !compact && !d.thumbnail, 'publication-lead': !compact && d.authorship !== 'coauthor' }]}
  data-publication-card={!compact ? '' : undefined}
  data-areas={!compact ? d.areas.join(' ') : undefined}
  data-themes={!compact ? d.themes.join(' ') : undefined}
  data-status={!compact ? d.status : undefined}
  data-authorship={!compact ? d.authorship : undefined}
>
  {hasThumbnail && <a href={`/publications/${pub.id}/`} class="publication-preview" tabindex="-1" aria-hidden="true"><ResearchThumbnail id={pub.id} /></a>}
  <div class="publication-copy">
    <PublicationMeta publication={d} />
    <Heading class:list={{ 'publication-title-small': compact && pub.id === 'neurips-2026-offline-priors' }}><a href={`/publications/${pub.id}/`}>{displayTitle}</a></Heading>
    <p class="publication-authors">
      {authors.map((author, index) => <span class={author.emphasized ? 'self-author' : ''}>{author.displayName}{index < authors.length - 1 ? ', ' : ''}</span>)}
      {!compact && hasEqualContributors && <span class="publication-equal-contribution">* Equal contribution</span>}
    </p>
    {!compact && d.thumbnail && <div class="publication-figure-column"><PublicationFigure thumbnail={d.thumbnail} title={d.title} /></div>}
    {!compact && <p class="publication-summary">{d.tldr}</p>}
    {!compact && <dl class="publication-classification">
      <div class="publication-classification-group">
        <dt>Area</dt>
        <dd><ul>{d.areas.map((area) => <li>{publicationAreaLabels[area]}</li>)}</ul></dd>
      </div>
      {d.themes.length > 0 && <div class="publication-classification-group">
        <dt>Themes</dt>
        <dd><ul>{d.themes.map((theme) => <li>{publicationThemeLabels[theme]}</li>)}</ul></dd>
      </div>}
    </dl>}
    <div class="publication-links">
      {d.links.pdf && <a href={d.links.pdf}><PublicationResourceIcon name="paper" />Paper</a>}
      {d.links.code && <a href={d.links.code}><PublicationResourceIcon name="code" />Code</a>}
      {!compact && d.links.bibtex && <a download href={d.links.bibtex}><PublicationResourceIcon name="bibtex" />BibTeX</a>}
      {d.links.project && <a href={d.links.project}><PublicationResourceIcon name="project" />Project</a>}
      {d.links.video && <a href={d.links.video}><PublicationResourceIcon name="video" />Video</a>}
    </div>
  </div>
</article>

<style>
  .publication-index-card { position: relative; grid-template-columns: 260px minmax(0, 1fr); align-items: start; column-gap: 32px; row-gap: 0; padding: 28px; }
  .publication-index-card.publication-lead { background: color-mix(in srgb, var(--color-brand) 6%, var(--color-bg-primary)); }
  .publication-index-card.publication-lead::before { content: ''; position: absolute; inset-block: 28px; inset-inline-start: 0; width: 3px; border-radius: 3px; background: var(--color-brand); }
  .publication-index-card[hidden] { display: none !important; }
  .publication-index-card .publication-copy { display: contents; }
  .publication-index-card .publication-copy > :global(*) { grid-column: 2; min-width: 0; }
  .publication-index-card :global(.publication-meta) { grid-row: 1; flex-direction: row; flex-wrap: wrap; align-items: center; gap: 8px 12px; margin-bottom: 12px; padding-top: 0; }
  .publication-index-card .publication-copy :is(h2, h3) { grid-row: 2; }
  .publication-index-card .publication-authors { grid-row: 3; }
  .publication-index-card .publication-figure-column { grid-column: 1; grid-row: 1 / span 6; align-self: center; }
  .publication-index-card .publication-summary { grid-row: 4; }
  .publication-index-card .publication-classification { grid-row: 5; }
  .publication-index-card .publication-links { grid-row: 6; }
  .publication-index-card.publication-without-figure { grid-template-columns: minmax(0, 1fr); }
  .publication-index-card.publication-without-figure .publication-copy > :global(*) { grid-column: 1; }
  .publication-figure-column { min-width: 0; }
  .publication-equal-contribution { display: block; margin-top: 3px; font-size: 14px; line-height: 1.5; color: var(--color-text-tertiary); }
  .publication-classification { display: grid; gap: 3px; margin-top: 14px; color: var(--color-text-tertiary); font-size: 14px; line-height: 1.5; }
  .publication-classification-group { display: flex; align-items: baseline; gap: 10px; }
  .publication-classification dt { flex: 0 0 46px; font-weight: 500; }
  .publication-classification dd { min-width: 0; margin: 0; }
  .publication-classification ul { display: flex; flex-wrap: wrap; gap: 3px 12px; padding: 0; list-style: none; }
  .publication-classification li + li::before { content: '·'; margin-right: 12px; }
  @media (max-width: 960px) {
    .publication-index-card { grid-template-columns: 220px minmax(0, 1fr); column-gap: 24px; padding: 24px; }
  }
  @media (max-width: 680px) {
    .publication-index-card { grid-template-columns: minmax(0, 1fr); align-items: start; gap: 0; }
    .publication-index-card .publication-copy > :global(*) { grid-column: 1; }
    .publication-index-card :global(.publication-meta) { grid-row: 1; margin-bottom: 12px; }
    .publication-index-card .publication-copy :is(h2, h3) { grid-row: 2; }
    .publication-index-card .publication-authors { grid-row: 3; margin-top: 12px; }
    .publication-index-card .publication-figure-column { grid-row: 4; margin-top: 20px; }
    .publication-index-card .publication-summary { grid-row: 5; margin-top: 12px; }
    .publication-index-card .publication-classification { grid-row: 6; margin-top: 12px; }
    .publication-index-card .publication-links { grid-row: 7; margin-top: 8px; }
  }
  @media (max-width: 380px) {
    .publication-index-card { padding: 20px; }
  }
</style>
