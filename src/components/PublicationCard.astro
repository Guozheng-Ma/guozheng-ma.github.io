---
import { type CollectionEntry } from 'astro:content';
interface Props { pub: CollectionEntry<'publications'>; compact?: boolean; headingLevel?: 'h2' | 'h3'; }
const { pub, compact = false, headingLevel: Heading = 'h3' } = Astro.props;
const d = pub.data;
---
<article class:list={['publication-card', { 'publication-compact': compact }]}>
  <div class="publication-meta"><p>{d.venue} {d.year}</p>{d.venueFull.includes('Position') && <p>Position paper</p>}{d.award && <p class="honor">{d.award}</p>}</div>
  <div class="publication-copy">
    <Heading><a href={`/publications/${pub.id}/`}>{d.title}</a></Heading>
    {!compact && <p class="publication-authors">{d.authors.map((a, i) => <span class={d.authorBoldIndices.includes(i) ? 'self-author' : ''}>{a}{i < d.authors.length - 1 ? ', ' : ''}</span>)}</p>}
    <p class="publication-summary">{d.tldr}</p>
    <div class="publication-links">
      {d.links.pdf && <a href={d.links.pdf}>Paper</a>}
      {d.links.code && <a href={d.links.code}>Code</a>}
      {!compact && d.links.bibtex && <a download href={d.links.bibtex}>BibTeX</a>}
      {d.links.project && <a href={d.links.project}>Project</a>}
      {d.links.video && <a href={d.links.video}>Video</a>}
    </div>
  </div>
</article>
