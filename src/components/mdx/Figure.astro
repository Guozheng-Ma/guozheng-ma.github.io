---
interface Props {
  src: string;
  caption: string;
  width?: string;
}
const { src, caption, width } = Astro.props;
---
<figure class="prose-figure" style={width ? `--figure-width: ${width};` : undefined}>
  <img src={src} alt={caption} loading="lazy" />
  <figcaption class="figure-caption">{caption}</figcaption>
</figure>
