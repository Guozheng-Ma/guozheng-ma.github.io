---
import { getEntry } from 'astro:content';

interface Props { slug: string; }
const { slug } = Astro.props;
const pub = await getEntry('publications', slug);
if (!pub) throw new Error(`PaperCard: publication "${slug}" not found.`);
const d = pub.data;
---
<div class="paper-reference">
  <p class="paper-reference-meta">{d.venue} · {d.year}{d.award && <span> · {d.award}</span>}</p>
  <a href={`/publications/${pub.id}/`} class="paper-reference-title">{d.title}</a>
  <p class="paper-reference-summary">{d.tldr}</p>
</div>
<style>
  .paper-reference { padding-block: 1.25rem; border-block: 1px solid var(--color-border-tertiary); }
  .paper-reference-meta { font: 500 .875rem/1.5 var(--font-sans); color: var(--color-text-secondary); margin: 0 0 .5rem; }
  .paper-reference-title { font: 600 1.125rem/1.4 var(--font-sans); color: var(--color-text-primary); }
  .paper-reference-summary { margin-top: .65rem; color: var(--color-text-secondary); font: 400 1rem/1.6 var(--font-serif); }
  @media print { .paper-reference { break-inside: avoid; } }
</style>
