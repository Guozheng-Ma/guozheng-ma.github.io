---
import { getEntry } from 'astro:content';

interface Props { slug: string; }
const { slug } = Astro.props;
const pub = await getEntry('publications', slug);
if (!pub) throw new Error(`PaperCard: publication "${slug}" not found.`);
const d = pub.data;
---
<div class="paper-reference">
  <p class="article-meta">{d.venue} · {d.year}{d.award && <span> · {d.award}</span>}</p>
  <a href={`/publications/${pub.id}/`} class="related-link">{d.title}</a>
  <p class="related-summary">{d.tldr}</p>
</div>
