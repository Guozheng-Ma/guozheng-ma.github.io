---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import NoteCard from '../../components/NoteCard.astro';
const notes = (await getCollection('notes', ({ data }) => !data.draft)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---
<Layout title="Blog — Guozheng Ma" description="Posts on agentic robot learning, sparsity, plasticity, and data augmentation in deep reinforcement learning.">
  <main id="main-content" class="site-width">
    <div class="page-intro">
      <h1>Blog</h1>
    </div>
    <div class="notes-index">{notes.map((note) => <NoteCard note={note} headingLevel="h2" />)}</div>
  </main>
</Layout>
