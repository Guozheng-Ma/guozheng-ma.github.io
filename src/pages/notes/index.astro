---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CoverArt from '../../components/CoverArt.astro';

const notes = (await getCollection('notes', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || a.data.title.localeCompare(b.data.title));
const directionOrder = ['agentic-policy', 'online-learning-from-experience', 'learning-dynamics-and-pathologies'];
const directions = directionOrder.flatMap((id) => notes.filter((note) => note.id === id));
const essays = notes.filter((note) => !note.data.tags.includes('research-direction'));
const dateLabel = (date: Date) => date.toLocaleDateString('en-US', {
  month: 'long', day: 'numeric', year: 'numeric', timeZone: 'UTC',
});
---
<Layout title="Blog — Guozheng Ma" description="Research notes and perspectives on how agents learn, adapt, and scale.">
  <main id="main-content" class="blog-index">
    <header class="blog-intro">
      <h1>Blog</h1>
      <p>Questions, mechanisms, and perspectives on how agents learn.</p>
    </header>

    <section class="blog-essays" aria-label="Research notes" id="research-notes">
      {essays.map((note) => (
        <article class="blog-entry" aria-labelledby={`post-${note.id}`}>
          <div class="blog-entry-copy">
            <p class="blog-entry-date"><time datetime={note.data.date.toISOString().slice(0, 10)}>{dateLabel(note.data.date)}</time></p>
            <h2 id={`post-${note.id}`}><a href={`/notes/${note.id}/`}>{note.data.title}</a></h2>
            <p class="blog-entry-summary">{note.data.tldr}</p>
          </div>
          <div class="blog-entry-art" aria-hidden="true">
            <CoverArt color={note.data.cover.color} art={note.data.cover.art} />
          </div>
        </article>
      ))}
    </section>

    <section class="blog-directions" aria-labelledby="directions">
      <div class="blog-directions-heading">
        <h2 id="directions">Research directions</h2>
        <a href="/#research">Research overview</a>
      </div>
      <ul>
        {directions.map((note) => <li><a href={`/notes/${note.id}/`}>{note.data.title}</a></li>)}
      </ul>
    </section>
  </main>
</Layout>
<style is:global>
  /* This archive has its own reading layout; the homepage keeps its existing structure. */
  .blog-index { width: min(calc(100% - var(--page-gutter) * 2), 992px); margin: 3.5rem auto 6rem; }
  .blog-index .blog-intro { max-width: 720px; margin: 0 auto 3.5rem; text-align: center; }
  .blog-index .blog-intro h1 { font: 700 clamp(2rem, 3.5vw, 2.75rem)/1.15 var(--font-sans); letter-spacing: -.035em; color: var(--color-text-primary); }
  .blog-index .blog-intro p { max-width: 560px; margin: 1.1rem auto 0; color: var(--color-text-secondary); font: 400 1.125rem/1.68 var(--font-serif); }
  .blog-index .blog-essays { border-top: 1px solid var(--color-border-tertiary); }
  .blog-index .blog-entry { display: grid; grid-template-columns: minmax(0, 1fr) 208px; gap: 3rem; align-items: center; padding: 2.4rem 0; border-bottom: 1px solid var(--color-border-tertiary); }
  .blog-index .blog-entry-copy { min-width: 0; }
  .blog-index .blog-entry-date { margin-bottom: .55rem; color: var(--color-text-secondary); font: 400 .875rem/1.6 var(--font-sans); }
  .blog-index .blog-entry h2 { margin: 0; font: 700 1.5rem/1.3 var(--font-sans); letter-spacing: -.025em; text-wrap: pretty; }
  .blog-index .blog-entry h2 a { display: inline-block; padding-block: .35rem; }
  .blog-index .blog-entry-summary { max-width: 620px; margin-top: .6rem; color: var(--color-text-secondary); font: 400 1.125rem/1.68 var(--font-serif); font-optical-sizing: auto; }
  .blog-index .blog-entry-art { min-width: 0; }
  .blog-index .blog-entry-art .cover-art { overflow: hidden; border-radius: 6px; background: transparent; }
  .blog-index .blog-directions { margin-top: 3.5rem; }
  .blog-index .blog-directions-heading { display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; align-items: baseline; justify-content: space-between; }
  .blog-index .blog-directions h2 { font: 600 1.125rem/1.4 var(--font-sans); letter-spacing: -.01em; }
  .blog-index .blog-directions-heading > a { display: inline-flex; align-items: center; min-height: 44px; color: var(--color-brand); font: 400 .9375rem/1.5 var(--font-sans); }
  .blog-index .blog-directions ul { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 1rem 1.5rem; padding: 0; margin: .75rem 0 0; list-style: none; }
  .blog-index .blog-directions li { min-width: 0; }
  .blog-index .blog-directions li a { display: block; padding-block: .6rem; color: var(--color-text-secondary); font: 400 1rem/1.55 var(--font-sans); }
  @media (max-width: 800px) {
    .blog-index .blog-entry { grid-template-columns: minmax(0, 1fr) 170px; gap: 2rem; }
    .blog-index .blog-directions ul { grid-template-columns: 1fr; gap: .1rem; }
  }
  @media (max-width: 600px) {
    .blog-index { margin-block: 2.5rem 4rem; }
    .blog-index .blog-intro { margin-bottom: 2.5rem; }
    .blog-index .blog-entry { grid-template-columns: 1fr; gap: 1.4rem; padding-block: 2rem; }
    .blog-index .blog-entry h2 { font-size: 1.375rem; }
    .blog-index .blog-entry-art { width: min(100%, 208px); }
    .blog-index .blog-directions { margin-top: 2.5rem; }
  }
  @media print {
    .blog-index { width: 100%; max-width: none; margin: 0; }
    .blog-index .blog-entry { break-inside: avoid; grid-template-columns: minmax(0, 1fr) 150px; }
    .blog-index .blog-directions ul { grid-template-columns: 1fr; }
  }
</style>
