---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CoverArt from '../../components/CoverArt.astro';
import Aside from '../../components/mdx/Aside.astro';
import MathBlock from '../../components/mdx/MathBlock.astro';
import PaperCard from '../../components/mdx/PaperCard.astro';
import Figure from '../../components/mdx/Figure.astro';

export async function getStaticPaths() {
  const allNotes = (await getCollection('notes', ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || a.data.title.localeCompare(b.data.title));
  return allNotes.map((note) => ({
    params: { id: note.id },
    props: {
      note,
      moreNotes: allNotes.filter((other) => other.id !== note.id),
    },
  }));
}

const { note, moreNotes } = Astro.props;
const { Content } = await render(note);
const relatedPub = note.data.relatedPub ? await getEntry('publications', note.data.relatedPub) : null;
const dateStr = note.data.date.toLocaleDateString('en-US', {
  timeZone: 'UTC',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
---
<Layout title={note.data.title} description={note.data.tldr} type="article">
  <main id="main-content" class="reading-page">
    <header class="article-header">
      <a href="/notes/" class="back-link">← Notes</a>
      <h1 class="page-title">{note.data.title}</h1>
      <p class="article-meta"><time datetime={note.data.date.toISOString().slice(0, 10)}>{dateStr}</time></p>
    </header>

    <article class="prose article-body">
      <Content components={{ Aside, MathBlock, PaperCard, Figure }} />
    </article>

    <div class="note-illustration">
      <CoverArt motif={note.data.cover.motif} color={note.data.cover.color} aspectRatio="3 / 2" />
    </div>

    {relatedPub && (
      <section class="related-section" aria-labelledby="related-paper-title">
        <h2 id="related-paper-title" class="related-title">Related paper</h2>
        <a href={`/publications/${relatedPub.id}/`} class="related-link">{relatedPub.data.title}</a>
      </section>
    )}

    {moreNotes.length > 0 && (
      <nav class="related-section" aria-labelledby="more-notes-title">
        <h2 id="more-notes-title" class="related-title">More notes</h2>
        <ul class="more-notes-list">
          {moreNotes.map((other) => (
            <li><a href={`/notes/${other.id}/`} class="related-link">{other.data.title}</a></li>
          ))}
        </ul>
      </nav>
    )}
  </main>
</Layout>
