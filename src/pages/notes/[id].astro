---
import { getCollection, getEntry, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import CoverArt from '../../components/CoverArt.astro';
import Aside from '../../components/mdx/Aside.astro';
import MathBlock from '../../components/mdx/MathBlock.astro';
import PaperCard from '../../components/mdx/PaperCard.astro';
import Figure from '../../components/mdx/Figure.astro';
import Details from '../../components/mdx/Details.astro';
import { resolveNoteArt } from '../../lib/note-art';
import '../../styles/article.css';

export async function getStaticPaths() {
  const allNotes = (await getCollection('notes', ({ data }) => !data.draft))
    .sort((a, b) => b.data.date.getTime() - a.data.date.getTime() || a.data.title.localeCompare(b.data.title));
  return allNotes.map((note) => ({
    params: { id: note.id },
    props: {
      note,
      moreNotes: allNotes
        .filter((other) => other.id !== note.id && other.data.tags.includes('research-direction') === note.data.tags.includes('research-direction'))
        .sort((a, b) => {
          const shared = (tags: string[]) => tags.filter((tag) => note.data.tags.includes(tag)).length;
          return shared(b.data.tags) - shared(a.data.tags);
        })
        .slice(0, 2),
    },
  }));
}

const { note, moreNotes } = Astro.props;
const { Content } = await render(note);
const relatedPub = note.data.relatedPub ? await getEntry('publications', note.data.relatedPub) : null;
const shareImage = resolveNoteArt(note.data.cover).src;
const dateStr = note.data.date.toLocaleDateString('en-US', {
  timeZone: 'UTC',
  month: 'long',
  day: 'numeric',
  year: 'numeric',
});
const isDirection = note.data.tags.includes('research-direction');
---
<Layout title={note.data.title} description={note.data.tldr} image={shareImage} type="article">
  <main id="main-content" class="journal-article">
    <article aria-labelledby="note-title">
      <header class="journal-header">
        <p class="journal-category"><a href={isDirection ? '/#research' : '/notes/'}>{isDirection ? 'Research direction' : 'Research blog'}</a><span aria-hidden="true">·</span><time datetime={note.data.date.toISOString().slice(0, 10)}>{dateStr}</time></p>
        <h1 id="note-title" class="journal-title">{note.data.title}</h1>
        <p class="journal-byline"><a href="/about/">Guozheng Ma</a></p>
      </header>

      <section class="journal-summary" aria-labelledby="summary-title">
        <h2 id="summary-title">TL;DR</h2>
        <p>{note.data.tldr}</p>
      </section>
      {relatedPub?.data.thumbnail ? (
        <figure class="journal-evidence">
          <a href={relatedPub.data.thumbnail.src} target="_blank" rel="noopener" aria-label={`View full-size figure: ${relatedPub.data.thumbnail.alt}`}>
            <img src={relatedPub.data.thumbnail.src} alt={relatedPub.data.thumbnail.alt} width={relatedPub.data.thumbnail.width} height={relatedPub.data.thumbnail.height} loading="eager" decoding="async" />
          </a>
          <figcaption>{relatedPub.data.thumbnail.alt} <a href={relatedPub.data.links.pdf || `/publications/${relatedPub.id}/`}>Source: {relatedPub.data.venue} {relatedPub.data.year}</a></figcaption>
        </figure>
      ) : (
        <figure class="journal-visual">
          <CoverArt motif={note.data.cover.motif} color={note.data.cover.color} art={note.data.cover.art} />
          <figcaption>Concept illustration</figcaption>
        </figure>
      )}
      <div class="journal-reading">
        <div class="prose journal-prose">
          <Content components={{ Aside, MathBlock, PaperCard, Figure, Details }} />
        </div>
      </div>
    </article>

    <footer class="journal-end">
      {relatedPub && (
        <section class="journal-paper" aria-labelledby="related-paper-title">
          <h2 id="related-paper-title">Related paper</h2>
          <p class="journal-paper-meta">{relatedPub.data.venue} · {relatedPub.data.year}</p>
          <a href={`/publications/${relatedPub.id}/`} class="journal-paper-title">{relatedPub.data.title}</a>
          <p class="journal-paper-summary">{relatedPub.data.tldr}</p>
        </section>
      )}
      {moreNotes.length > 0 && (
        <nav class="journal-more" aria-labelledby="more-notes-title">
          <div class="journal-more-heading">
            <h2 id="more-notes-title">{isDirection ? 'Other research directions' : 'Continue reading'}</h2>
            <a href={isDirection ? '/#research' : '/notes/'}>{isDirection ? 'Research overview' : 'All posts'}</a>
          </div>
          <ul>
            {moreNotes.map((other) => (
              <li>
                <a href={`/notes/${other.id}/`}>{other.data.title}</a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </footer>
  </main>
</Layout>
