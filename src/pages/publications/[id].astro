---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PublicationMeta from '../../components/PublicationMeta.astro';
import PublicationResourceIcon from '../../components/PublicationResourceIcon.astro';

export async function getStaticPaths() {
  const pubs = await getCollection('publications');
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  const noteByRelatedPub = new Map(
    notes.filter((note) => note.data.relatedPub).map((note) => [note.data.relatedPub, note])
  );
  return pubs.map((pub) => ({
    params: { id: pub.id },
    props: { pub, relatedNote: noteByRelatedPub.get(pub.id) ?? null },
  }));
}

const { pub, relatedNote } = Astro.props;
const { Content } = await render(pub);
const d = pub.data;
---
<Layout title={d.title} description={d.tldr} image={d.figure} type="article">
  <main id="main-content" class="reading-page publication-detail">
    <header class="article-header">
      <a href="/publications/" class="back-link">← Publications</a>
      <PublicationMeta publication={d} fullVenue />
      <h1 class="page-title">{d.title}</h1>
      <p class="article-authors">
        {d.authors.map((author, index) => (
          <span class={d.authorBoldIndices.includes(index) ? 'self-author' : undefined}>{author}{index < d.authors.length - 1 ? ', ' : ''}</span>
        ))}
      </p>
      <div class="article-actions" aria-label="Publication resources">
        {d.links.pdf && <a href={d.links.pdf}><PublicationResourceIcon name="paper" />Paper</a>}
        {d.links.code && <a href={d.links.code}><PublicationResourceIcon name="code" />Code</a>}
        {d.links.bibtex && <a download href={d.links.bibtex}><PublicationResourceIcon name="bibtex" />BibTeX</a>}
        {d.links.project && <a href={d.links.project}><PublicationResourceIcon name="project" />Project</a>}
        {d.links.video && <a href={d.links.video}><PublicationResourceIcon name="video" />Video</a>}
      </div>
    </header>

    <article class="prose article-body">
      <Content />
    </article>

    {relatedNote && (
      <section class="related-section" aria-labelledby="related-note-title">
        <h2 id="related-note-title" class="related-title">Related note</h2>
        <a href={`/notes/${relatedNote.id}/`} class="related-link">{relatedNote.data.title}</a>
        <p class="related-summary">{relatedNote.data.tldr}</p>
      </section>
    )}
  </main>
</Layout>
