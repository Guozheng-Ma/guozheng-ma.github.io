---
import { getCollection } from 'astro:content';
import Layout from '../../layouts/Layout.astro';
import PublicationCard from '../../components/PublicationCard.astro';
import ContinuationArrow from '../../components/ContinuationArrow.astro';
import { profile } from '../../data/profile';
import { publicationAreas, publicationThemes } from '../../data/publication-topics';
import { publicationStatuses, publicationStatusLabels } from '../../lib/publication-presentation';
const pubs = (await getCollection('publications')).sort((a,b) => b.data.year - a.data.year || (a.data.featuredOrder ?? 99) - (b.data.featuredOrder ?? 99));
const areaFilters = [
  { id: 'all', label: 'All', count: pubs.length },
  ...publicationAreas.map((area) => ({ ...area, count: pubs.filter((pub) => pub.data.areas.includes(area.id)).length })),
];
const themeFilters = [
  { id: 'all', label: 'All', count: pubs.length },
  ...publicationThemes.map((theme) => ({ ...theme, count: pubs.filter((pub) => pub.data.themes.includes(theme.id)).length })),
];
const statusFilters = [
  { id: 'all', label: 'All', count: pubs.length },
  ...publicationStatuses.map((status) => ({ id: status, label: publicationStatusLabels[status], count: pubs.filter((pub) => pub.data.status === status).length })),
];
const leadCount = pubs.filter((pub) => pub.data.authorship !== 'coauthor').length;
---
<Layout title="Publications — Guozheng Ma" description="Publications and preprints by Guozheng Ma. Browse by author role, research area, research theme, and publication status.">
  <main id="main-content" class="site-width publications-page">
    <div class="page-intro publication-page-intro">
      <h1>Publications</h1>
      <a href={profile.scholar} class="continuation-link scholar-record"><span>Full record on Google Scholar</span><ContinuationArrow /></a>
    </div>
    <div class="publication-filter-panel" data-publication-filters hidden>
      <fieldset class="publication-filter-dimension">
        <legend>Area</legend>
        <div class="publication-filters">
          {areaFilters.map((filter) => (
            <button type="button" class="publication-filter" data-area-filter={filter.id} data-filter-label={filter.label} aria-pressed={filter.id === 'all' ? 'true' : 'false'} aria-controls="publication-results">
              <span>{filter.label}</span><span class="filter-count" data-filter-count aria-hidden="true">{filter.count}</span>
            </button>
          ))}
        </div>
      </fieldset>
      <fieldset class="publication-filter-dimension">
        <legend>Research Themes</legend>
        <div class="publication-filters">
          {themeFilters.map((filter) => (
            <button type="button" class="publication-filter" data-theme-filter={filter.id} data-filter-label={filter.label} aria-pressed={filter.id === 'all' ? 'true' : 'false'} aria-controls="publication-results">
              <span>{filter.label}</span><span class="filter-count" data-filter-count aria-hidden="true">{filter.count}</span>
            </button>
          ))}
        </div>
      </fieldset>
      <div class="publication-mobile-filters">
        <label class="publication-filter-field" for="publication-area-mobile">
          <span>Area</span>
          <select id="publication-area-mobile" name="area" data-area-select aria-controls="publication-results">
            {areaFilters.map((filter) => <option value={filter.id} data-option-label={filter.label}>{filter.label} · {filter.count}</option>)}
          </select>
        </label>
        <label class="publication-filter-field" for="publication-theme-mobile">
          <span>Theme</span>
          <select id="publication-theme-mobile" name="theme" data-theme-select aria-label="Research Theme" aria-controls="publication-results">
            {themeFilters.map((filter) => <option value={filter.id} data-option-label={filter.label}>{filter.label} · {filter.count}</option>)}
          </select>
        </label>
      </div>
      <div class="publication-secondary-filters">
        <label class="publication-filter-field" for="publication-role">
          <span>Role</span>
          <select id="publication-role" name="role" data-role-filter aria-controls="publication-results">
            <option value="all" data-option-label="All">All · {pubs.length}</option>
            <option value="lead" data-option-label="First & co-first">First &amp; co-first · {leadCount}</option>
            <option value="coauthor" data-option-label="Co-author">Co-author · {pubs.length - leadCount}</option>
          </select>
        </label>
        <label class="publication-filter-field" for="publication-status">
          <span>Status</span>
          <select id="publication-status" name="status" data-status-filter aria-controls="publication-results">
            {statusFilters.map((filter) => <option value={filter.id} data-option-label={filter.label}>{filter.label} · {filter.count}</option>)}
          </select>
        </label>
      </div>
      <div class="publication-filter-summary">
        <p class="publication-result-count" role="status" aria-live="polite" aria-atomic="true" data-publication-count>{pubs.length} publications</p>
        <button type="button" class="publication-clear" data-clear-filters disabled>Clear filters</button>
      </div>
    </div>
    <div id="publication-results" class="publications-list">{pubs.map(pub => <PublicationCard pub={pub} headingLevel="h2" />)}</div>
    <section class="publication-empty" data-publication-empty hidden aria-labelledby="publication-empty-title">
      <h2 id="publication-empty-title">No matching publications</h2>
      <p>Try a different area, theme, role, or status.</p>
      <button type="button" class="publication-clear" data-clear-filters>Clear filters</button>
    </section>
  </main>
</Layout>

<style>
  .publication-page-intro { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px 24px; }
  .scholar-record { font-size: 16px; }
  .publication-filter-panel { margin: -8px 0 28px; }
  .publication-filter-panel[hidden], .publication-empty[hidden] { display: none !important; }
  .publication-filter-dimension { min-width: 0; margin: 0; padding: 0; border: 0; }
  .publication-filter-dimension + .publication-filter-dimension { margin-top: 18px; }
  .publication-filter-dimension legend { padding: 0; margin-bottom: 8px; color: var(--color-text-secondary); font: 500 14px / 1.5 var(--font-sans); }
  .publication-filters { display: flex; flex-wrap: wrap; gap: 8px 10px; }
  .publication-filter { display: inline-flex; align-items: center; justify-content: center; gap: 10px; min-height: 44px; padding: 9px 17px; border: 1px solid transparent; border-radius: 999px; background: var(--color-bg-primary); color: var(--color-text-secondary); font: 500 16px / 1.4 var(--font-sans); cursor: pointer; }
  .publication-filter:hover { color: var(--color-text-primary); background: var(--color-bg-secondary); }
  .publication-filter[aria-pressed='true'] { color: var(--color-bg-tertiary); background: var(--color-text-primary); }
  .publication-filter:focus-visible { outline-offset: 4px; }
  .filter-count { opacity: .75; font-size: 14px; font-variant-numeric: tabular-nums; }
  .publication-mobile-filters { display: none; }
  .publication-secondary-filters { display: flex; flex-wrap: wrap; gap: 12px 24px; margin-top: 20px; }
  .publication-filter-field { display: flex; align-items: center; gap: 10px; color: var(--color-text-secondary); font-size: 14px; }
  .publication-filter-field select { min-width: 164px; min-height: 44px; padding: 8px 12px; border: 1px solid var(--color-border-tertiary); border-radius: 10px; background: var(--color-bg-tertiary); color: var(--color-text-primary); font: 400 16px / 1.4 var(--font-sans); cursor: pointer; }
  .publication-filter-field:first-child select { min-width: 190px; }
  .publication-filter-field select:hover { border-color: var(--color-border-secondary); }
  .publication-filter-summary { display: flex; align-items: center; justify-content: space-between; gap: 12px; margin-top: 10px; }
  .publication-result-count { color: var(--color-text-secondary); font-size: 15px; line-height: 1.5; }
  .publication-clear { min-height: 44px; padding: 8px 0; border: 0; background: transparent; color: var(--color-text-primary); font: 500 15px / 1.5 var(--font-sans); white-space: nowrap; cursor: pointer; }
  .publication-clear:hover { text-decoration: underline; text-underline-offset: 3px; }
  .publication-clear:disabled { color: var(--color-text-tertiary); opacity: .6; text-decoration: none; cursor: default; }
  .publication-empty { padding: 40px 28px; margin-bottom: 48px; border-radius: var(--radius-xl); background: var(--color-bg-primary); text-align: center; }
  .publication-empty h2 { font: 400 28px / 1.3 var(--font-serif); }
  .publication-empty p { margin-top: 12px; color: var(--color-text-secondary); }
  .publication-empty .publication-clear { margin-top: 14px; }
  @media (max-width: 680px) {
    .publication-page-intro { gap: 4px; }
    .scholar-record { font-size: 15px; }
    .publication-filter-panel { margin-top: -4px; margin-bottom: 24px; }
    .publication-filter-dimension { display: none; }
    .publication-mobile-filters, .publication-secondary-filters { display: grid; grid-template-columns: minmax(0, 1fr); gap: 8px; }
    .publication-secondary-filters { margin-top: 8px; }
    .publication-filter-field { display: grid; grid-template-columns: 54px minmax(0, 1fr); align-items: center; gap: 10px; min-width: 0; }
    .publication-filter-field select, .publication-filter-field:first-child select { min-width: 0; width: 100%; padding-inline: 8px; }
    .publication-filter-summary { margin-top: 6px; }
    .publication-result-count { font-size: 14px; }
    .publication-empty { padding: 32px 20px; }
    .publication-empty h2 { font-size: 25px; }
  }
</style>

<script>
  import { defaultPublicationFilters, matchesPublication, publicationFiltersFromParams, type FilterablePublication, type PublicationFilters } from '../../lib/publication-filtering';
  import type { PublicationStatus, PublicationAuthorship } from '../../lib/publication-presentation';

  const filterPanel = document.querySelector<HTMLElement>('[data-publication-filters]');
  const areaControls = [...document.querySelectorAll<HTMLButtonElement>('[data-area-filter]')];
  const themeControls = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-filter]')];
  const areaSelect = document.querySelector<HTMLSelectElement>('[data-area-select]');
  const themeSelect = document.querySelector<HTMLSelectElement>('[data-theme-select]');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-publication-card]')];
  const statusSelect = document.querySelector<HTMLSelectElement>('[data-status-filter]');
  const roleSelect = document.querySelector<HTMLSelectElement>('[data-role-filter]');
  const resultCount = document.querySelector<HTMLElement>('[data-publication-count]');
  const emptyState = document.querySelector<HTMLElement>('[data-publication-empty]');
  const clearButtons = [...document.querySelectorAll<HTMLButtonElement>('[data-clear-filters]')];

  if (filterPanel && areaControls.length && themeControls.length && areaSelect && themeSelect && statusSelect && roleSelect && resultCount && emptyState) {
    const records: Array<FilterablePublication & { element: HTMLElement }> = cards.map((element) => ({
      element,
      areas: element.dataset.areas?.split(' ').filter(Boolean) ?? [],
      themes: element.dataset.themes?.split(' ').filter(Boolean) ?? [],
      status: element.dataset.status as PublicationStatus,
      authorship: element.dataset.authorship as PublicationAuthorship,
    }));
    let current: PublicationFilters = { ...defaultPublicationFilters };
    const filtersFromUrl = () => publicationFiltersFromParams(new URL(window.location.href).searchParams);
    const countMatching = (filters: PublicationFilters) => records.filter((record) => matchesPublication(record, filters)).length;

    const updateButtons = (controls: HTMLButtonElement[], dimension: 'area' | 'theme') => {
      controls.forEach((control) => {
        const value = (dimension === 'area' ? control.dataset.areaFilter : control.dataset.themeFilter) ?? 'all';
        const count = countMatching({ ...current, [dimension]: value });
        control.setAttribute('aria-pressed', String(value === current[dimension]));
        control.setAttribute('aria-label', `${control.dataset.filterLabel}, ${count} ${count === 1 ? 'publication' : 'publications'}`);
        const counter = control.querySelector<HTMLElement>('[data-filter-count]');
        if (counter) counter.textContent = String(count);
      });
    };

    const applyFilters = (next: PublicationFilters, updateUrl = false) => {
      current = { ...next };
      let visibleCount = 0;
      records.forEach((record) => {
        const visible = matchesPublication(record, current);
        record.element.hidden = !visible;
        if (visible) visibleCount += 1;
      });

      // Facet counts apply the other three selections; All also includes papers with no theme.
      updateButtons(areaControls, 'area');
      updateButtons(themeControls, 'theme');
      Array.from(areaSelect.options).forEach((option) => {
        const count = countMatching({ ...current, area: option.value });
        option.textContent = `${option.dataset.optionLabel} · ${count}`;
      });
      Array.from(themeSelect.options).forEach((option) => {
        const count = countMatching({ ...current, theme: option.value });
        option.textContent = `${option.dataset.optionLabel} · ${count}`;
      });
      areaSelect.value = current.area;
      themeSelect.value = current.theme;
      Array.from(statusSelect.options).forEach((option) => {
        const count = countMatching({ ...current, status: option.value as PublicationFilters['status'] });
        option.textContent = `${option.dataset.optionLabel} · ${count}`;
      });
      Array.from(roleSelect.options).forEach((option) => {
        const count = countMatching({ ...current, role: option.value as PublicationFilters['role'] });
        option.textContent = `${option.dataset.optionLabel} · ${count}`;
      });
      statusSelect.value = current.status;
      roleSelect.value = current.role;

      const hasSelection = Object.values(current).some((value) => value !== 'all');
      resultCount.textContent = hasSelection
        ? `${visibleCount} of ${records.length} publications`
        : `${visibleCount} ${visibleCount === 1 ? 'publication' : 'publications'}`;
      emptyState.hidden = visibleCount > 0;
      clearButtons.forEach((button) => { button.disabled = !hasSelection; });

      if (updateUrl) {
        const url = new URL(window.location.href);
        url.searchParams.delete('topic');
        (['area', 'theme', 'status', 'role'] as const).forEach((key) => {
          if (current[key] === 'all') url.searchParams.delete(key);
          else url.searchParams.set(key, current[key]);
        });
        if (url.href !== window.location.href) {
          try {
            window.history.pushState(null, '', url);
          } catch { /* Filtering remains usable if history changes are unavailable. */ }
        }
      }
    };

    areaControls.forEach((control) => control.addEventListener('click', () => {
      applyFilters({ ...current, area: control.dataset.areaFilter ?? 'all' }, true);
    }));
    themeControls.forEach((control) => control.addEventListener('click', () => {
      applyFilters({ ...current, theme: control.dataset.themeFilter ?? 'all' }, true);
    }));
    areaSelect.addEventListener('change', () => applyFilters({ ...current, area: areaSelect.value }, true));
    themeSelect.addEventListener('change', () => applyFilters({ ...current, theme: themeSelect.value }, true));
    statusSelect.addEventListener('change', () => applyFilters({ ...current, status: statusSelect.value as PublicationFilters['status'] }, true));
    roleSelect.addEventListener('change', () => applyFilters({ ...current, role: roleSelect.value as PublicationFilters['role'] }, true));
    clearButtons.forEach((button) => button.addEventListener('click', () => {
      applyFilters({ ...defaultPublicationFilters }, true);
      if (areaSelect.getClientRects().length > 0) areaSelect.focus();
      else areaControls[0]?.focus();
    }));
    window.addEventListener('popstate', () => applyFilters(filtersFromUrl()));
    applyFilters(filtersFromUrl());
    filterPanel.hidden = false;
  }
</script>
