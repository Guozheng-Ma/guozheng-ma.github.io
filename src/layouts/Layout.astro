---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = "Guozheng Ma — research notes and publications on deep reinforcement learning.",
  image = '/art/sparsity.webp',
  type = 'website',
  noindex = false,
} = Astro.props;

const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const ogImage = new URL(image, Astro.site).toString();
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link id="site-favicon" rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {!noindex && <link rel="canonical" href={canonicalUrl} />}
    {noindex && <meta name="robots" content="noindex" />}

    <title>{title}</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:url" content={canonicalUrl} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="author" content="Guozheng Ma" />
    <meta name="theme-color" content="#fafaf8" />
    <meta name="color-scheme" content="light dark" />
    <script is:inline>
      (() => {
        let preference = 'system';
        try {
          const saved = localStorage.getItem('guozheng-theme');
          if (saved === 'light' || saved === 'dark') preference = saved;
        } catch { /* Fall back to the system when storage is unavailable. */ }
        const dark = preference === 'dark' || (preference === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
        document.documentElement.dataset.theme = preference;
        document.documentElement.classList.toggle('dark', dark);
        document.querySelector('meta[name="theme-color"]').setAttribute('content', dark ? '#191919' : '#fafaf8');
        document.querySelector('#site-favicon').setAttribute('href', dark ? '/favicon-dark.svg' : '/favicon-light.svg');
      })();
    </script>
    <link rel="preload" href="/fonts/source-sans-3-variable.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/source-serif-4-400-normal.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body class="bg-page text-fg">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header currentPath={Astro.url.pathname} />
    <slot />
    <Footer />
  </body>
</html>
